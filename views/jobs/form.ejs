<%- include('../layout-top') %>
<div class="page-head">
  <div>
    <h1><%= job ? 'Edit job' : 'New job' %></h1>
    <p>Won work in the <%= SERVICE_AREA %> service area.</p>
  </div>
  <a class="btn" href="/jobs">Cancel</a>
</div>

<div class="card card-b pad">
  <form class="form wide" method="post" action="<%= job ? '/jobs/' + job.id + '?_method=PUT' : '/jobs' %>">
    <div class="form-row cols-2">
      <div>
        <label>Account *</label>
        <select name="account_id" required>
          <option value="">Select…</option>
          <% accounts.forEach(a => { %>
            <option value="<%= a.id %>" <%= job && String(job.account_id) === String(a.id) ? 'selected' : '' %>><%= a.company %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label>Linked deal (optional)</label>
        <select name="deal_id">
          <option value="">None</option>
          <% deals.forEach(d => { %>
            <option value="<%= d.id %>" <%= job && String(job.deal_id) === String(d.id) ? 'selected' : '' %>><%= d.company %> — <%= d.job_city || d.stage %> (#<%= d.id %>)</option>
          <% }) %>
        </select>
      </div>
    </div>
    <div>
      <label>Title *</label>
      <input name="title" required value="<%= job ? job.title : '' %>" />
    </div>
    <div class="form-row cols-3">
      <div>
        <label>Job city</label>
        <input name="job_city" value="<%= job ? job.job_city || '' : '' %>" />
      </div>
      <div>
        <label>Scope</label>
        <select name="scope_type">
          <% SCOPE_TYPES.forEach(s => { %>
            <option value="<%= s %>" <%= job && job.scope_type === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label>Status</label>
        <select name="status">
          <% ['active','on_hold','complete'].forEach(s => { %>
            <option value="<%= s %>" <%= job && job.status === s ? 'selected' : (!job && s === 'active' ? 'selected' : '') %>><%= label(s) %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="form-row cols-2">
      <div>
        <label>Contract value</label>
        <input type="number" step="1" name="contract_value" value="<%= job ? job.contract_value : 0 %>" />
      </div>
      <div>
        <label>Start date</label>
        <input type="date" name="start_date" value="<%= job ? job.start_date || '' : '' %>" />
      </div>
    </div>
    <div>
      <label>Notes</label>
      <textarea name="notes"><%= job ? job.notes || '' : '' %></textarea>
    </div>
    <div class="actions">
      <button class="btn btn-primary" type="submit"><%= job ? 'Save job' : 'Create job' %></button>
      <% if (job) { %>
        <button class="btn btn-danger" type="submit" formaction="/jobs/<%= job.id %>?_method=DELETE" formmethod="post" onclick="return confirm('Delete job?')">Delete</button>
      <% } %>
    </div>
  </form>
</div>
<%- include('../layout-bottom') %>
